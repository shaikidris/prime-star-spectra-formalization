import PrimeStar.Localization
import Mathlib.Analysis.Normed.Algebra.MatrixExponential
import Mathlib.Analysis.Complex.Trigonometric
import Mathlib.Analysis.SpecialFunctions.Exponential
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Bounds
import Mathlib.Topology.Algebra.Module.FiniteDimension

/-!
# Adjacency evolution on finite prime-cover graphs

This file supplies the finite-dimensional exponential identities used by the
continuous-time adjacency evolution.  The core statement is deliberately
matrix-theoretic: the exponential of a matrix acts on an eigenvector by the
exponential of its eigenvalue.
-/

namespace PrimeStar

open scoped InnerProductSpace Matrix

noncomputable section

local instance adjacencyEvolutionPrimeCoverDecidableAdj
    (S : Finset ℕ) (X : ℕ) :
    DecidableRel (primeCoverGraph S X).Adj :=
  Classical.decRel _

/-- Powers of a continuous endomorphism act by powers of the eigenvalue on
an eigenvector. -/
theorem ContinuousLinearMap.pow_apply_of_apply_eq
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (A : E →L[ℂ] E) (v : E) (z : ℂ)
    (hv : A v = z • v) (n : ℕ) :
    (A ^ n) v = z ^ n • v := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [pow_succ]
      change (A ^ n) (A v) = z ^ (n + 1) • v
      rw [hv, map_smul, ih, smul_smul]
      congr 1
      ring

/-- Operator exponential on a continuous-linear eigenvector. -/
theorem ContinuousLinearMap.exp_apply_of_apply_eq
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]
    (A : E →L[ℂ] E) (v : E) (z : ℂ)
    (hv : A v = z • v) :
    NormedSpace.exp A v = Complex.exp z • v := by
  let F := ContinuousLinearMap.apply ℂ E v
  have hsumA : Summable (fun n : ℕ => (Nat.factorial n : ℂ)⁻¹ • A ^ n) :=
    NormedSpace.expSeries_summable' A
  have hmap :
      F (∑' n : ℕ, (Nat.factorial n : ℂ)⁻¹ • A ^ n) =
        ∑' n : ℕ, F ((Nat.factorial n : ℂ)⁻¹ • A ^ n) :=
    F.map_tsum hsumA
  rw [NormedSpace.exp_eq_tsum ℂ]
  change F (∑' n : ℕ, (Nat.factorial n : ℂ)⁻¹ • A ^ n) = _
  rw [hmap]
  change (∑' n : ℕ, (Nat.factorial n : ℂ)⁻¹ • (A ^ n) v) = _
  simp_rw [ContinuousLinearMap.pow_apply_of_apply_eq A v z hv, smul_smul]
  have hsumz : Summable (fun n : ℕ ↦ (Nat.factorial n : ℂ)⁻¹ * z ^ n) := by
    simpa [smul_eq_mul] using
      (NormedSpace.expSeries_summable' (𝕂 := ℂ) (𝔸 := ℂ) z)
  rw [hsumz.tsum_smul_const]
  congr 1
  rw [Complex.exp_eq_exp_ℂ]
  rw [NormedSpace.exp_eq_tsum ℂ]
  simp only [smul_eq_mul]

/-- The continuous-time evolution generated by a bounded operator, with the
physics convention `exp (-itA)`. -/
def adjacencyEvolutionOperator
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]
    (A : E →L[ℂ] E) (t : ℝ) : E →L[ℂ] E :=
  NormedSpace.exp ((-((t : ℂ) * Complex.I)) • A)

/-- A self-adjoint generator gives a unitary adjacency evolution. -/
theorem adjacencyEvolutionOperator_mem_unitary
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [CompleteSpace E]
    {A : E →L[ℂ] E} (hA : IsSelfAdjoint A) (t : ℝ) :
    adjacencyEvolutionOperator A t ∈ unitary (E →L[ℂ] E) := by
  letI : NormedAlgebra ℚ (E →L[ℂ] E) := .restrictScalars ℚ ℂ _
  apply NormedSpace.exp_mem_unitary_of_mem_skewAdjoint
  apply hA.smul_mem_skewAdjoint
  rw [skewAdjoint.mem_iff]
  simp

/-- Self-adjoint adjacency evolution preserves the Hilbert norm, uniformly
in time. -/
theorem norm_adjacencyEvolutionOperator
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [CompleteSpace E]
    {A : E →L[ℂ] E} (hA : IsSelfAdjoint A) (t : ℝ) (x : E) :
    ‖adjacencyEvolutionOperator A t x‖ = ‖x‖ :=
  ContinuousLinearMap.norm_map_of_mem_unitary
    (adjacencyEvolutionOperator_mem_unitary hA t) x

/-- Exact phase acquired by an eigenvector under adjacency evolution. -/
theorem adjacencyEvolutionOperator_apply_eigenvector
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]
    (A : E →L[ℂ] E) (v : E) (lam : ℝ) (t : ℝ)
    (hv : A v = (lam : ℂ) • v) :
    adjacencyEvolutionOperator A t v =
      Complex.exp (-(((t * lam : ℝ) : ℂ) * Complex.I)) • v := by
  apply ContinuousLinearMap.exp_apply_of_apply_eq
  simp only [smul_apply, hv, smul_smul]
  congr 1
  push_cast
  ring_nf

/-- The prime-cover adjacency, acting on the complex Euclidean vertex space. -/
def primeCoverComplexAdjacencyOperator (S : Finset ℕ) (X : ℕ) :
    EuclideanSpace ℂ (Vertex S X) →L[ℂ] EuclideanSpace ℂ (Vertex S X) :=
  LinearMap.toContinuousLinearMap
    (Matrix.toEuclideanLin ((primeCoverGraph S X).adjMatrix ℂ))

/-- The complex prime-cover adjacency operator is self-adjoint. -/
theorem primeCoverComplexAdjacencyOperator_isSelfAdjoint
    (S : Finset ℕ) (X : ℕ) :
    IsSelfAdjoint (primeCoverComplexAdjacencyOperator S X) := by
  apply LinearMap.IsSymmetric.isSelfAdjoint
  exact Matrix.isSymmetric_toEuclideanLin_iff.mpr
    ((primeCoverGraph S X).isHermitian_adjMatrix (R := ℂ))

/-- The actual finite prime-cover adjacency evolution. -/
def primeCoverAdjacencyEvolution (S : Finset ℕ) (X : ℕ) (t : ℝ) :
    EuclideanSpace ℂ (Vertex S X) →L[ℂ] EuclideanSpace ℂ (Vertex S X) :=
  adjacencyEvolutionOperator (primeCoverComplexAdjacencyOperator S X) t

/-- The actual finite prime-cover evolution preserves norm for every time. -/
theorem norm_primeCoverAdjacencyEvolution
    (S : Finset ℕ) (X : ℕ) (t : ℝ)
    (x : EuclideanSpace ℂ (Vertex S X)) :
    ‖primeCoverAdjacencyEvolution S X t x‖ = ‖x‖ :=
  norm_adjacencyEvolutionOperator
    (primeCoverComplexAdjacencyOperator_isSelfAdjoint S X) t x

/-- Coordinatewise inclusion of a real Euclidean vector into the complex
Euclidean space. -/
def complexifyEuclidean
    {ι : Type*} [Fintype ι] (x : EuclideanSpace ℝ ι) :
    EuclideanSpace ℂ ι :=
  WithLp.toLp 2 (fun i ↦ (x i : ℂ))

@[simp]
theorem complexifyEuclidean_apply
    {ι : Type*} [Fintype ι] (x : EuclideanSpace ℝ ι) (i : ι) :
    complexifyEuclidean x i = (x i : ℂ) :=
  rfl

/-- Real-to-complex inclusion preserves the Euclidean norm. -/
theorem norm_complexifyEuclidean
    {ι : Type*} [Fintype ι] (x : EuclideanSpace ℝ ι) :
    ‖complexifyEuclidean x‖ = ‖x‖ := by
  have hsquares : ‖complexifyEuclidean x‖ ^ 2 = ‖x‖ ^ 2 := by
    rw [EuclideanSpace.norm_sq_eq, EuclideanSpace.real_norm_sq_eq]
    apply Finset.sum_congr rfl
    intro i _hi
    simp [complexifyEuclidean]
  nlinarith [norm_nonneg (complexifyEuclidean x), norm_nonneg x]

/-- Complexifying commutes with real scalar multiplication. -/
theorem complexifyEuclidean_smul
    {ι : Type*} [Fintype ι] (r : ℝ) (x : EuclideanSpace ℝ ι) :
    complexifyEuclidean (r • x) = (r : ℂ) • complexifyEuclidean x := by
  apply PiLp.ext
  intro i
  simp [complexifyEuclidean]

/-- Complexifying commutes with the prime-cover adjacency action. -/
theorem primeCoverComplexAdjacencyOperator_complexify
    (S : Finset ℕ) (X : ℕ) (x : EuclideanSpace ℝ (Vertex S X)) :
    primeCoverComplexAdjacencyOperator S X (complexifyEuclidean x) =
      complexifyEuclidean
        (Matrix.toEuclideanLin ((primeCoverGraph S X).adjMatrix ℝ) x) := by
  apply PiLp.ext
  intro i
  simp only [primeCoverComplexAdjacencyOperator,
    LinearMap.coe_toContinuousLinearMap', Matrix.toLpLin_apply,
    complexifyEuclidean_apply]
  simp only [Matrix.mulVec, dotProduct, SimpleGraph.adjMatrix_apply]
  push_cast
  apply Finset.sum_congr rfl
  intro j _hj
  rw [show (complexifyEuclidean x).ofLp j = (x.ofLp j : ℂ) from rfl]
  by_cases hij : (primeCoverGraph S X).Adj i j
  · rw [if_pos hij, if_pos hij]
    norm_num
  · rw [if_neg hij, if_neg hij]
    norm_num

/-- Every real adjacency eigenvector gives the corresponding complex
eigenvector of the actual adjacency operator. -/
theorem primeCoverComplexAdjacencyOperator_apply_complexify_eigenvector
    {S : Finset ℕ} {X : ℕ}
    (v : EuclideanSpace ℝ (Vertex S X)) (lam : ℝ)
    (hv : Matrix.toEuclideanLin ((primeCoverGraph S X).adjMatrix ℝ) v =
      lam • v) :
    primeCoverComplexAdjacencyOperator S X (complexifyEuclidean v) =
      (lam : ℂ) • complexifyEuclidean v := by
  rw [primeCoverComplexAdjacencyOperator_complexify, hv,
    complexifyEuclidean_smul]

/-- Exact phase evolution for an actual real eigenvector of the finite
prime-cover graph. -/
theorem primeCoverAdjacencyEvolution_apply_complexify_eigenvector
    {S : Finset ℕ} {X : ℕ}
    (v : EuclideanSpace ℝ (Vertex S X)) (lam t : ℝ)
    (hv : Matrix.toEuclideanLin ((primeCoverGraph S X).adjMatrix ℝ) v =
      lam • v) :
    primeCoverAdjacencyEvolution S X t (complexifyEuclidean v) =
      Complex.exp (-(((t * lam : ℝ) : ℂ) * Complex.I)) •
        complexifyEuclidean v :=
  adjacencyEvolutionOperator_apply_eigenvector _ _ lam t
    (primeCoverComplexAdjacencyOperator_apply_complexify_eigenvector v lam hv)

/-- The normalized centre combination of a positive/negative mode pair. -/
def normalizedPairCentre
    {ι : Type*} [Fintype ι]
    (vplus vminus : EuclideanSpace ℂ ι) : EuclideanSpace ℂ ι :=
  ((Real.sqrt 2 : ℂ)⁻¹) • (vplus + vminus)

/-- The normalized shell combination of a positive/negative mode pair. -/
def normalizedPairShell
    {ι : Type*} [Fintype ι]
    (vplus vminus : EuclideanSpace ℂ ι) : EuclideanSpace ℂ ι :=
  ((Real.sqrt 2 : ℂ)⁻¹) • (vplus - vminus)

/-- Exact two-phase evolution of the centre combination of a paired real
eigenbasis. -/
theorem primeCoverAdjacencyEvolution_normalizedPairCentre
    {S : Finset ℕ} {X : ℕ}
    (vplus vminus : EuclideanSpace ℝ (Vertex S X)) (lam t : ℝ)
    (hplus : Matrix.toEuclideanLin ((primeCoverGraph S X).adjMatrix ℝ) vplus =
      lam • vplus)
    (hminus : Matrix.toEuclideanLin ((primeCoverGraph S X).adjMatrix ℝ) vminus =
      (-lam) • vminus) :
    primeCoverAdjacencyEvolution S X t
        (normalizedPairCentre (complexifyEuclidean vplus)
          (complexifyEuclidean vminus)) =
      ((Real.sqrt 2 : ℂ)⁻¹) •
        (Complex.exp (-(((t * lam : ℝ) : ℂ) * Complex.I)) •
            complexifyEuclidean vplus +
          Complex.exp ((((t * lam : ℝ) : ℂ) * Complex.I)) •
            complexifyEuclidean vminus) := by
  rw [normalizedPairCentre, map_smul, map_add,
    primeCoverAdjacencyEvolution_apply_complexify_eigenvector
      vplus lam t hplus,
    primeCoverAdjacencyEvolution_apply_complexify_eigenvector
      vminus (-lam) t hminus]
  congr 2
  congr 1
  push_cast
  ring_nf

/-- The two opposite phases are exactly the cosine centre motion minus the
imaginary sine shell motion. -/
theorem normalizedPhasePair_eq_cos_sub_I_sin
    {ι : Type*} [Fintype ι]
    (vplus vminus : EuclideanSpace ℂ ι) (theta : ℝ) :
    ((Real.sqrt 2 : ℂ)⁻¹) •
        (Complex.exp (-(((theta : ℝ) : ℂ) * Complex.I)) • vplus +
          Complex.exp (((theta : ℝ) : ℂ) * Complex.I) • vminus) =
      (Real.cos theta : ℂ) • normalizedPairCentre vplus vminus -
        (Complex.I * Real.sin theta) • normalizedPairShell vplus vminus := by
  rw [Complex.exp_ofReal_mul_I]
  have hneg :
      Complex.exp (-(((theta : ℝ) : ℂ) * Complex.I)) =
        (Real.cos theta : ℂ) - (Real.sin theta : ℂ) * Complex.I := by
    simpa using (Complex.cos_sub_sin_I (theta : ℂ)).symm
  rw [hneg]
  apply PiLp.ext
  intro i
  simp only [normalizedPairCentre, normalizedPairShell, PiLp.smul_apply,
    PiLp.add_apply, PiLp.sub_apply, smul_eq_mul]
  ring

/-- Exact centre--shell oscillation for the paired eigenvectors of the actual
prime-cover adjacency. -/
theorem primeCoverAdjacencyEvolution_pairCentre_eq_cos_sub_I_sin
    {S : Finset ℕ} {X : ℕ}
    (vplus vminus : EuclideanSpace ℝ (Vertex S X)) (lam t : ℝ)
    (hplus : Matrix.toEuclideanLin ((primeCoverGraph S X).adjMatrix ℝ) vplus =
      lam • vplus)
    (hminus : Matrix.toEuclideanLin ((primeCoverGraph S X).adjMatrix ℝ) vminus =
      (-lam) • vminus) :
    primeCoverAdjacencyEvolution S X t
        (normalizedPairCentre (complexifyEuclidean vplus)
          (complexifyEuclidean vminus)) =
      (Real.cos (lam * t) : ℂ) •
          normalizedPairCentre (complexifyEuclidean vplus)
            (complexifyEuclidean vminus) -
        (Complex.I * Real.sin (lam * t)) •
          normalizedPairShell (complexifyEuclidean vplus)
            (complexifyEuclidean vminus) := by
  rw [primeCoverAdjacencyEvolution_normalizedPairCentre
    vplus vminus lam t hplus hminus]
  simpa [mul_comm] using
    normalizedPhasePair_eq_cos_sub_I_sin
      (complexifyEuclidean vplus) (complexifyEuclidean vminus) (lam * t)

/-- The normalization coefficient of a two-mode pair has norm at most one. -/
theorem norm_inv_real_sqrt_two_le_one :
    ‖((Real.sqrt 2 : ℂ)⁻¹)‖ ≤ 1 := by
  have hsqrtNorm : ‖(Real.sqrt 2 : ℂ)‖ = Real.sqrt 2 := by
    exact Complex.norm_of_nonneg (Real.sqrt_nonneg _)
  rw [norm_inv, hsqrtNorm]
  have hsqrt : 1 ≤ Real.sqrt 2 := by
    nlinarith [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2), Real.sqrt_nonneg 2]
  exact (inv_le_one₀ (by positivity)).2 hsqrt

/-- Complexification commutes with subtraction. -/
theorem complexifyEuclidean_sub
    {ι : Type*} [Fintype ι]
    (x y : EuclideanSpace ℝ ι) :
    complexifyEuclidean (x - y) = complexifyEuclidean x - complexifyEuclidean y := by
  apply PiLp.ext
  intro i
  simp [complexifyEuclidean]

/-- Stability of the normalized centre combination. -/
theorem norm_normalizedPairCentre_sub_le
    {ι : Type*} [Fintype ι]
    (xplus xminus yplus yminus : EuclideanSpace ℂ ι) :
    ‖normalizedPairCentre xplus xminus -
        normalizedPairCentre yplus yminus‖ ≤
      ‖xplus - yplus‖ + ‖xminus - yminus‖ := by
  rw [normalizedPairCentre, normalizedPairCentre, ← smul_sub]
  calc
    ‖((Real.sqrt 2 : ℂ)⁻¹) •
        ((xplus + xminus) - (yplus + yminus))‖ =
        ‖((Real.sqrt 2 : ℂ)⁻¹)‖ *
          ‖(xplus + xminus) - (yplus + yminus)‖ := norm_smul _ _
    _ ≤ 1 * ‖(xplus + xminus) - (yplus + yminus)‖ := by
      gcongr
      exact norm_inv_real_sqrt_two_le_one
    _ ≤ ‖xplus - yplus‖ + ‖xminus - yminus‖ := by
      rw [one_mul]
      have hdecomp :
          (xplus + xminus) - (yplus + yminus) =
            (xplus - yplus) + (xminus - yminus) := by module
      rw [hdecomp]
      exact norm_add_le _ _

/-- The exact two-phase vector associated with a mode pair. -/
def normalizedPhasePair
    {ι : Type*} [Fintype ι]
    (vplus vminus : EuclideanSpace ℂ ι) (theta : ℝ) :
    EuclideanSpace ℂ ι :=
  ((Real.sqrt 2 : ℂ)⁻¹) •
    (Complex.exp (-(((theta : ℝ) : ℂ) * Complex.I)) • vplus +
      Complex.exp (((theta : ℝ) : ℂ) * Complex.I) • vminus)

/-- Stability of the two-phase vector; the bound is uniform in the phase. -/
theorem norm_normalizedPhasePair_sub_le
    {ι : Type*} [Fintype ι]
    (xplus xminus yplus yminus : EuclideanSpace ℂ ι) (theta : ℝ) :
    ‖normalizedPhasePair xplus xminus theta -
        normalizedPhasePair yplus yminus theta‖ ≤
      ‖xplus - yplus‖ + ‖xminus - yminus‖ := by
  rw [normalizedPhasePair, normalizedPhasePair, ← smul_sub]
  have hminusPhase :
      ‖Complex.exp (-(((theta : ℝ) : ℂ) * Complex.I))‖ = 1 := by
    rw [Complex.norm_exp]
    simp
  have hplusPhase :
      ‖Complex.exp (((theta : ℝ) : ℂ) * Complex.I)‖ = 1 := by
    rw [Complex.norm_exp]
    simp
  calc
    ‖((Real.sqrt 2 : ℂ)⁻¹) •
        ((Complex.exp (-(((theta : ℝ) : ℂ) * Complex.I)) • xplus +
            Complex.exp (((theta : ℝ) : ℂ) * Complex.I) • xminus) -
          (Complex.exp (-(((theta : ℝ) : ℂ) * Complex.I)) • yplus +
            Complex.exp (((theta : ℝ) : ℂ) * Complex.I) • yminus))‖ =
        ‖((Real.sqrt 2 : ℂ)⁻¹)‖ * _ := norm_smul _ _
    _ ≤ 1 * ‖(Complex.exp (-(((theta : ℝ) : ℂ) * Complex.I)) • xplus +
            Complex.exp (((theta : ℝ) : ℂ) * Complex.I) • xminus) -
          (Complex.exp (-(((theta : ℝ) : ℂ) * Complex.I)) • yplus +
            Complex.exp (((theta : ℝ) : ℂ) * Complex.I) • yminus)‖ := by
      gcongr
      exact norm_inv_real_sqrt_two_le_one
    _ ≤ ‖xplus - yplus‖ + ‖xminus - yminus‖ := by
      rw [one_mul]
      have hdecomp :
          (Complex.exp (-(((theta : ℝ) : ℂ) * Complex.I)) • xplus +
              Complex.exp (((theta : ℝ) : ℂ) * Complex.I) • xminus) -
            (Complex.exp (-(((theta : ℝ) : ℂ) * Complex.I)) • yplus +
              Complex.exp (((theta : ℝ) : ℂ) * Complex.I) • yminus) =
            Complex.exp (-(((theta : ℝ) : ℂ) * Complex.I)) • (xplus - yplus) +
              Complex.exp (((theta : ℝ) : ℂ) * Complex.I) • (xminus - yminus) := by
        module
      rw [hdecomp]
      calc
        ‖Complex.exp (-(((theta : ℝ) : ℂ) * Complex.I)) • (xplus - yplus) +
            Complex.exp (((theta : ℝ) : ℂ) * Complex.I) • (xminus - yminus)‖ ≤
            ‖Complex.exp (-(((theta : ℝ) : ℂ) * Complex.I)) • (xplus - yplus)‖ +
              ‖Complex.exp (((theta : ℝ) : ℂ) * Complex.I) •
                (xminus - yminus)‖ := norm_add_le _ _
        _ = ‖xplus - yplus‖ + ‖xminus - yminus‖ := by
          rw [norm_smul, norm_smul, hminusPhase, hplusPhase, one_mul, one_mul]

/-- Finite centre--shell evolution with an explicit uniform stability bound.
If the exact positive and negative eigenvectors are each within `eps` of the
chosen comparison modes, the oscillation error is at most `4 eps` for every
real time. -/
theorem primeCoverAdjacencyEvolution_pair_localization
    {S : Finset ℕ} {X : ℕ}
    (vplus vminus uplus uminus : EuclideanSpace ℝ (Vertex S X))
    (lam t eps : ℝ)
    (hplus : Matrix.toEuclideanLin ((primeCoverGraph S X).adjMatrix ℝ) vplus =
      lam • vplus)
    (hminus : Matrix.toEuclideanLin ((primeCoverGraph S X).adjMatrix ℝ) vminus =
      (-lam) • vminus)
    (_heps : 0 ≤ eps)
    (hclosePlus : ‖vplus - uplus‖ ≤ eps)
    (hcloseMinus : ‖vminus - uminus‖ ≤ eps) :
    ‖primeCoverAdjacencyEvolution S X t
          (normalizedPairCentre (complexifyEuclidean uplus)
            (complexifyEuclidean uminus)) -
        ((Real.cos (lam * t) : ℂ) •
            normalizedPairCentre (complexifyEuclidean uplus)
              (complexifyEuclidean uminus) -
          (Complex.I * Real.sin (lam * t)) •
            normalizedPairShell (complexifyEuclidean uplus)
              (complexifyEuclidean uminus))‖ ≤
      4 * eps := by
  let vc := normalizedPairCentre (complexifyEuclidean vplus)
    (complexifyEuclidean vminus)
  let uc := normalizedPairCentre (complexifyEuclidean uplus)
    (complexifyEuclidean uminus)
  let phaseV := normalizedPhasePair (complexifyEuclidean vplus)
    (complexifyEuclidean vminus) (lam * t)
  let phaseU := normalizedPhasePair (complexifyEuclidean uplus)
    (complexifyEuclidean uminus) (lam * t)
  have hcp : ‖complexifyEuclidean vplus - complexifyEuclidean uplus‖ ≤ eps := by
    rw [← complexifyEuclidean_sub, norm_complexifyEuclidean]
    exact hclosePlus
  have hcm : ‖complexifyEuclidean vminus - complexifyEuclidean uminus‖ ≤ eps := by
    rw [← complexifyEuclidean_sub, norm_complexifyEuclidean]
    exact hcloseMinus
  have hcentre : ‖vc - uc‖ ≤ 2 * eps := by
    dsimp [vc, uc]
    calc
      _ ≤ ‖complexifyEuclidean vplus - complexifyEuclidean uplus‖ +
          ‖complexifyEuclidean vminus - complexifyEuclidean uminus‖ :=
        norm_normalizedPairCentre_sub_le _ _ _ _
      _ ≤ eps + eps := add_le_add hcp hcm
      _ = 2 * eps := by ring
  have hphase : ‖phaseV - phaseU‖ ≤ 2 * eps := by
    dsimp [phaseV, phaseU]
    calc
      _ ≤ ‖complexifyEuclidean vplus - complexifyEuclidean uplus‖ +
          ‖complexifyEuclidean vminus - complexifyEuclidean uminus‖ :=
        norm_normalizedPhasePair_sub_le _ _ _ _ _
      _ ≤ eps + eps := add_le_add hcp hcm
      _ = 2 * eps := by ring
  have hevolvc : primeCoverAdjacencyEvolution S X t vc = phaseV := by
    dsimp [vc, phaseV, normalizedPhasePair]
    simpa [mul_comm] using
      (primeCoverAdjacencyEvolution_normalizedPairCentre
        vplus vminus lam t hplus hminus)
  have htrigU :
      phaseU =
        (Real.cos (lam * t) : ℂ) • uc -
          (Complex.I * Real.sin (lam * t)) •
            normalizedPairShell (complexifyEuclidean uplus)
              (complexifyEuclidean uminus) := by
    dsimp [phaseU]
    exact normalizedPhasePair_eq_cos_sub_I_sin _ _ _
  change ‖primeCoverAdjacencyEvolution S X t uc - _‖ ≤ _
  rw [← htrigU]
  calc
    ‖primeCoverAdjacencyEvolution S X t uc - phaseU‖ ≤
        ‖primeCoverAdjacencyEvolution S X t uc -
            primeCoverAdjacencyEvolution S X t vc‖ +
          ‖primeCoverAdjacencyEvolution S X t vc - phaseU‖ :=
            norm_sub_le_norm_sub_add_norm_sub _ _ _
    _ = ‖uc - vc‖ + ‖phaseV - phaseU‖ := by
      rw [← map_sub, norm_primeCoverAdjacencyEvolution, hevolvc]
    _ ≤ 2 * eps + 2 * eps := by
      gcongr
      simpa [norm_sub_rev] using hcentre
    _ = 4 * eps := by ring

/-- Replacing the oscillation frequency costs at most a Lipschitz phase
error. -/
theorem norm_centreShellOscillation_sub_le
    {ι : Type*} [Fintype ι]
    (centre shell : EuclideanSpace ℂ ι)
    (lam hat t : ℝ)
    (hcentre : ‖centre‖ ≤ 1) (hshell : ‖shell‖ ≤ 1) :
    ‖((Real.cos (lam * t) : ℂ) • centre -
          (Complex.I * Real.sin (lam * t)) • shell) -
        ((Real.cos (hat * t) : ℂ) • centre -
          (Complex.I * Real.sin (hat * t)) • shell)‖ ≤
      2 * |t| * |lam - hat| := by
  have harg : |lam * t - hat * t| = |t| * |lam - hat| := by
    rw [← sub_mul, abs_mul, mul_comm]
  have hcos := Real.abs_cos_sub_cos_le (lam * t) (hat * t)
  have hsin := Real.abs_sin_sub_sin_le (lam * t) (hat * t)
  have hsinNorm :
      ‖(Real.sin (lam * t) : ℂ) - (Real.sin (hat * t) : ℂ)‖ =
        |Real.sin (lam * t) - Real.sin (hat * t)| := by
    rw [← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
  calc
    ‖((Real.cos (lam * t) : ℂ) • centre -
          (Complex.I * Real.sin (lam * t)) • shell) -
        ((Real.cos (hat * t) : ℂ) • centre -
          (Complex.I * Real.sin (hat * t)) • shell)‖ =
        ‖((Real.cos (lam * t) - Real.cos (hat * t) : ℝ) : ℂ) • centre -
          (Complex.I * (Real.sin (lam * t) - Real.sin (hat * t))) • shell‖ := by
      congr 1
      module
    _ ≤
        ‖(((Real.cos (lam * t) - Real.cos (hat * t) : ℝ) : ℂ) • centre)‖ +
          ‖((Complex.I * (Real.sin (lam * t) - Real.sin (hat * t))) • shell)‖ := by
      exact norm_sub_le _ _
    _ = |Real.cos (lam * t) - Real.cos (hat * t)| * ‖centre‖ +
        |Real.sin (lam * t) - Real.sin (hat * t)| * ‖shell‖ := by
      simp only [norm_smul, Complex.norm_mul, Complex.norm_I,
        Complex.norm_real, Real.norm_eq_abs, one_mul]
      rw [hsinNorm]
    _ ≤ |lam * t - hat * t| + |lam * t - hat * t| := by
      have hcos' :
          |Real.cos (lam * t) - Real.cos (hat * t)| * ‖centre‖ ≤
            |lam * t - hat * t| := by
        calc
          _ ≤ |Real.cos (lam * t) - Real.cos (hat * t)| * 1 :=
            mul_le_mul_of_nonneg_left hcentre (abs_nonneg _)
          _ = |Real.cos (lam * t) - Real.cos (hat * t)| := by ring
          _ ≤ _ := hcos
      have hsin' :
          |Real.sin (lam * t) - Real.sin (hat * t)| * ‖shell‖ ≤
            |lam * t - hat * t| := by
        calc
          _ ≤ |Real.sin (lam * t) - Real.sin (hat * t)| * 1 :=
            mul_le_mul_of_nonneg_left hshell (abs_nonneg _)
          _ = |Real.sin (lam * t) - Real.sin (hat * t)| := by ring
          _ ≤ _ := hsin
      exact add_le_add hcos' hsin'
    _ = 2 * |t| * |lam - hat| := by rw [harg]; ring

/-- Uniform centre--shell localization after replacing the exact eigenvalue
by an approximate frequency.  This is the finite Lipschitz bridge used by
Corollary 8.8. -/
theorem primeCoverAdjacencyEvolution_pair_localization_with_frequency
    {S : Finset ℕ} {X : ℕ}
    (vplus vminus uplus uminus : EuclideanSpace ℝ (Vertex S X))
    (lam hat t eps delta : ℝ)
    (hplus : Matrix.toEuclideanLin ((primeCoverGraph S X).adjMatrix ℝ) vplus =
      lam • vplus)
    (hminus : Matrix.toEuclideanLin ((primeCoverGraph S X).adjMatrix ℝ) vminus =
      (-lam) • vminus)
    (heps : 0 ≤ eps)
    (hclosePlus : ‖vplus - uplus‖ ≤ eps)
    (hcloseMinus : ‖vminus - uminus‖ ≤ eps)
    (hcentre : ‖normalizedPairCentre (complexifyEuclidean uplus)
        (complexifyEuclidean uminus)‖ ≤ 1)
    (hshell : ‖normalizedPairShell (complexifyEuclidean uplus)
        (complexifyEuclidean uminus)‖ ≤ 1)
    (hfreq : |lam - hat| ≤ delta) (_hdelta : 0 ≤ delta) :
    ‖primeCoverAdjacencyEvolution S X t
          (normalizedPairCentre (complexifyEuclidean uplus)
            (complexifyEuclidean uminus)) -
        ((Real.cos (hat * t) : ℂ) •
            normalizedPairCentre (complexifyEuclidean uplus)
              (complexifyEuclidean uminus) -
          (Complex.I * Real.sin (hat * t)) •
            normalizedPairShell (complexifyEuclidean uplus)
              (complexifyEuclidean uminus))‖ ≤
      4 * eps + 2 * |t| * delta := by
  let exactOsc :=
    (Real.cos (lam * t) : ℂ) •
        normalizedPairCentre (complexifyEuclidean uplus)
          (complexifyEuclidean uminus) -
      (Complex.I * Real.sin (lam * t)) •
        normalizedPairShell (complexifyEuclidean uplus)
          (complexifyEuclidean uminus)
  let approxOsc :=
    (Real.cos (hat * t) : ℂ) •
        normalizedPairCentre (complexifyEuclidean uplus)
          (complexifyEuclidean uminus) -
      (Complex.I * Real.sin (hat * t)) •
        normalizedPairShell (complexifyEuclidean uplus)
          (complexifyEuclidean uminus)
  have hexact :
      ‖primeCoverAdjacencyEvolution S X t
          (normalizedPairCentre (complexifyEuclidean uplus)
            (complexifyEuclidean uminus)) - exactOsc‖ ≤ 4 * eps := by
    exact primeCoverAdjacencyEvolution_pair_localization
      vplus vminus uplus uminus lam t eps hplus hminus heps
        hclosePlus hcloseMinus
  have hphase : ‖exactOsc - approxOsc‖ ≤ 2 * |t| * delta := by
    calc
      ‖exactOsc - approxOsc‖ ≤ 2 * |t| * |lam - hat| := by
        dsimp [exactOsc, approxOsc]
        exact norm_centreShellOscillation_sub_le _ _ lam hat t hcentre hshell
      _ ≤ 2 * |t| * delta := by
        gcongr
  change ‖primeCoverAdjacencyEvolution S X t _ - approxOsc‖ ≤ _
  exact (norm_sub_le_norm_sub_add_norm_sub _ exactOsc approxOsc).trans
    (add_le_add hexact hphase)

/-- A square-level spectral remainder gives the corresponding frequency
remainder after division by the sum of the positive frequencies. -/
theorem abs_sub_sqrt_le_of_abs_sq_sub_le
    {lam F eta : ℝ} (hlam : 0 < lam) (hF : 0 ≤ F) (_heta : 0 ≤ eta)
    (hbound : |lam ^ 2 - F| ≤ eta) :
    |lam - Real.sqrt F| ≤ eta / (lam + Real.sqrt F) := by
  have hsqrt0 : 0 ≤ Real.sqrt F := Real.sqrt_nonneg _
  have hden : 0 < lam + Real.sqrt F := add_pos_of_pos_of_nonneg hlam hsqrt0
  have hsquare : (Real.sqrt F) ^ 2 = F := Real.sq_sqrt hF
  have hfactor : lam ^ 2 - F =
      (lam - Real.sqrt F) * (lam + Real.sqrt F) := by
    calc
      lam ^ 2 - F = lam ^ 2 - (Real.sqrt F) ^ 2 := by rw [hsquare]
      _ = (lam - Real.sqrt F) * (lam + Real.sqrt F) := by ring
  rw [hfactor, abs_mul, abs_of_pos hden] at hbound
  exact (le_div_iff₀ hden).mpr hbound

/-- Complexification preserves the real Euclidean inner product. -/
theorem inner_complexifyEuclidean
    {ι : Type*} [Fintype ι]
    (x y : EuclideanSpace ℝ ι) :
    ⟪complexifyEuclidean x, complexifyEuclidean y⟫_ℂ =
      (⟪x, y⟫_ℝ : ℂ) := by
  simp [PiLp.inner_apply, complexifyEuclidean, RCLike.inner_apply]

/-- Positive and negative normalized modes of the same nonempty prime star
are orthogonal. -/
theorem real_inner_largePrimeNormalizedStarMode_pos_neg_eq_zero
    {S : Finset ℕ} {X Y : ℕ} {c : Vertex S X}
    (hd : 0 < largePrimeStarDegree S X Y c) :
    ⟪largePrimeNormalizedStarMode S X Y c 1,
      largePrimeNormalizedStarMode S X Y c (-1)⟫_ℝ = 0 := by
  let up := largePrimeEuclideanStarVector S X Y c 1
  let um := largePrimeEuclideanStarVector S X Y c (-1)
  have hup0 : up ≠ 0 := by
    dsimp [up, largePrimeEuclideanStarVector]
    rw [WithLp.toLp_eq_zero]
    exact largePrimeSignedStarVector_ne_zero hd
  have hum0 : um ≠ 0 := by
    dsimp [um, largePrimeEuclideanStarVector]
    rw [WithLp.toLp_eq_zero]
    exact largePrimeSignedStarVector_ne_zero hd
  have hunormed : ⟪up, um⟫_ℝ = 0 := by
    dsimp [up, um]
    rw [largePrimeEuclideanStarVector_eq_starDataVector,
      largePrimeEuclideanStarVector_eq_starDataVector,
      largePrimeStarDataVector_inner]
    have hsqrt :
        √(largePrimeStarDegree S X Y c : ℝ) *
            √(largePrimeStarDegree S X Y c : ℝ) =
          (largePrimeStarDegree S X Y c : ℝ) := by
      rw [← pow_two, Real.sq_sqrt (Nat.cast_nonneg _)]
    rw [hsqrt]
    simp [largePrimeStarDegree]
  rw [largePrimeNormalizedStarMode, largePrimeNormalizedStarMode,
    NormedSpace.normalize, NormedSpace.normalize]
  simp only [real_inner_smul_left, real_inner_smul_right]
  rw [hunormed]
  simp

/-- The centre combination of the exact positive/negative star pair is a
unit vector. -/
theorem norm_normalizedPairCentre_largePrimeStarModes
    {S : Finset ℕ} {X Y : ℕ} {c : Vertex S X}
    (hd : 0 < largePrimeStarDegree S X Y c) :
    ‖normalizedPairCentre
        (complexifyEuclidean (largePrimeNormalizedStarMode S X Y c 1))
        (complexifyEuclidean (largePrimeNormalizedStarMode S X Y c (-1)))‖ = 1 := by
  let up := complexifyEuclidean (largePrimeNormalizedStarMode S X Y c 1)
  let um := complexifyEuclidean (largePrimeNormalizedStarMode S X Y c (-1))
  have hup : ‖up‖ = 1 := by
    dsimp [up]
    rw [norm_complexifyEuclidean, norm_largePrimeNormalizedStarMode hd]
  have hum : ‖um‖ = 1 := by
    dsimp [um]
    rw [norm_complexifyEuclidean, norm_largePrimeNormalizedStarMode hd]
  have hinner : ⟪up, um⟫_ℂ = 0 := by
    dsimp [up, um]
    rw [inner_complexifyEuclidean,
      real_inner_largePrimeNormalizedStarMode_pos_neg_eq_zero hd]
    simp
  have hsum : ‖up + um‖ ^ 2 = 2 := by
    have h := norm_add_sq (𝕜 := ℂ) up um
    rw [hinner, hup, hum] at h
    norm_num at h ⊢
    exact h
  have hcoeff : ‖((Real.sqrt 2 : ℂ)⁻¹)‖ ^ 2 = 1 / 2 := by
    have hsqrtNorm : ‖(Real.sqrt 2 : ℂ)‖ = Real.sqrt 2 := by
      exact Complex.norm_of_nonneg (Real.sqrt_nonneg _)
    rw [norm_inv, hsqrtNorm, inv_pow,
      Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]
    norm_num
  have hnormsq :
      ‖normalizedPairCentre up um‖ ^ 2 = 1 := by
    rw [normalizedPairCentre, norm_smul, mul_pow, hcoeff, hsum]
    norm_num
  nlinarith [norm_nonneg (normalizedPairCentre up um)]

/-- The shell combination of the exact positive/negative star pair is a unit
vector. -/
theorem norm_normalizedPairShell_largePrimeStarModes
    {S : Finset ℕ} {X Y : ℕ} {c : Vertex S X}
    (hd : 0 < largePrimeStarDegree S X Y c) :
    ‖normalizedPairShell
        (complexifyEuclidean (largePrimeNormalizedStarMode S X Y c 1))
        (complexifyEuclidean (largePrimeNormalizedStarMode S X Y c (-1)))‖ = 1 := by
  let up := complexifyEuclidean (largePrimeNormalizedStarMode S X Y c 1)
  let um := complexifyEuclidean (largePrimeNormalizedStarMode S X Y c (-1))
  have hup : ‖up‖ = 1 := by
    dsimp [up]
    rw [norm_complexifyEuclidean, norm_largePrimeNormalizedStarMode hd]
  have hum : ‖um‖ = 1 := by
    dsimp [um]
    rw [norm_complexifyEuclidean, norm_largePrimeNormalizedStarMode hd]
  have hinner : ⟪up, um⟫_ℂ = 0 := by
    dsimp [up, um]
    rw [inner_complexifyEuclidean,
      real_inner_largePrimeNormalizedStarMode_pos_neg_eq_zero hd]
    simp
  have hsub : ‖up - um‖ ^ 2 = 2 := by
    have h := norm_sub_sq (𝕜 := ℂ) up um
    rw [hinner, hup, hum] at h
    norm_num at h ⊢
    exact h
  have hcoeff : ‖((Real.sqrt 2 : ℂ)⁻¹)‖ ^ 2 = 1 / 2 := by
    have hsqrtNorm : ‖(Real.sqrt 2 : ℂ)‖ = Real.sqrt 2 := by
      exact Complex.norm_of_nonneg (Real.sqrt_nonneg _)
    rw [norm_inv, hsqrtNorm, inv_pow,
      Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]
    norm_num
  have hnormsq :
      ‖normalizedPairShell up um‖ ^ 2 = 1 := by
    rw [normalizedPairShell, norm_smul, mul_pow, hcoeff, hsub]
    norm_num
  nlinarith [norm_nonneg (normalizedPairShell up um)]

/-- Corollary 6.2 at the finite level: a paired full-graph eigenbasis close
to the exact positive/negative prime-star modes produces a uniformly stable
centre--shell oscillation. -/
theorem primeCoverAdjacencyEvolution_starPair_localization
    {S : Finset ℕ} {X Y : ℕ} {c : Vertex S X}
    (vplus vminus : EuclideanSpace ℝ (Vertex S X))
    (lam t eps : ℝ)
    (_hd : 0 < largePrimeStarDegree S X Y c)
    (hplus : Matrix.toEuclideanLin ((primeCoverGraph S X).adjMatrix ℝ) vplus =
      lam • vplus)
    (hminus : Matrix.toEuclideanLin ((primeCoverGraph S X).adjMatrix ℝ) vminus =
      (-lam) • vminus)
    (heps : 0 ≤ eps)
    (hclosePlus : ‖vplus - largePrimeNormalizedStarMode S X Y c 1‖ ≤ eps)
    (hcloseMinus :
      ‖vminus - largePrimeNormalizedStarMode S X Y c (-1)‖ ≤ eps) :
    ‖primeCoverAdjacencyEvolution S X t
          (normalizedPairCentre
            (complexifyEuclidean (largePrimeNormalizedStarMode S X Y c 1))
            (complexifyEuclidean (largePrimeNormalizedStarMode S X Y c (-1)))) -
        ((Real.cos (lam * t) : ℂ) •
            normalizedPairCentre
              (complexifyEuclidean (largePrimeNormalizedStarMode S X Y c 1))
              (complexifyEuclidean (largePrimeNormalizedStarMode S X Y c (-1))) -
          (Complex.I * Real.sin (lam * t)) •
            normalizedPairShell
              (complexifyEuclidean (largePrimeNormalizedStarMode S X Y c 1))
              (complexifyEuclidean (largePrimeNormalizedStarMode S X Y c (-1))))‖ ≤
      4 * eps :=
  primeCoverAdjacencyEvolution_pair_localization
    vplus vminus
      (largePrimeNormalizedStarMode S X Y c 1)
      (largePrimeNormalizedStarMode S X Y c (-1))
      lam t eps hplus hminus heps hclosePlus hcloseMinus

/-- Corollary 8.8 at the finite level: the same prime-star oscillation may
use an approximate frequency at the additional Lipschitz phase cost. -/
theorem primeCoverAdjacencyEvolution_starPair_with_frequency
    {S : Finset ℕ} {X Y : ℕ} {c : Vertex S X}
    (vplus vminus : EuclideanSpace ℝ (Vertex S X))
    (lam hat t eps delta : ℝ)
    (hd : 0 < largePrimeStarDegree S X Y c)
    (hplus : Matrix.toEuclideanLin ((primeCoverGraph S X).adjMatrix ℝ) vplus =
      lam • vplus)
    (hminus : Matrix.toEuclideanLin ((primeCoverGraph S X).adjMatrix ℝ) vminus =
      (-lam) • vminus)
    (heps : 0 ≤ eps)
    (hclosePlus : ‖vplus - largePrimeNormalizedStarMode S X Y c 1‖ ≤ eps)
    (hcloseMinus :
      ‖vminus - largePrimeNormalizedStarMode S X Y c (-1)‖ ≤ eps)
    (hfreq : |lam - hat| ≤ delta) (hdelta : 0 ≤ delta) :
    ‖primeCoverAdjacencyEvolution S X t
          (normalizedPairCentre
            (complexifyEuclidean (largePrimeNormalizedStarMode S X Y c 1))
            (complexifyEuclidean (largePrimeNormalizedStarMode S X Y c (-1)))) -
        ((Real.cos (hat * t) : ℂ) •
            normalizedPairCentre
              (complexifyEuclidean (largePrimeNormalizedStarMode S X Y c 1))
              (complexifyEuclidean (largePrimeNormalizedStarMode S X Y c (-1))) -
          (Complex.I * Real.sin (hat * t)) •
            normalizedPairShell
              (complexifyEuclidean (largePrimeNormalizedStarMode S X Y c 1))
              (complexifyEuclidean (largePrimeNormalizedStarMode S X Y c (-1))))‖ ≤
      4 * eps + 2 * |t| * delta := by
  apply primeCoverAdjacencyEvolution_pair_localization_with_frequency
    vplus vminus
      (largePrimeNormalizedStarMode S X Y c 1)
      (largePrimeNormalizedStarMode S X Y c (-1))
      lam hat t eps delta hplus hminus heps hclosePlus hcloseMinus
  · exact (norm_normalizedPairCentre_largePrimeStarModes hd).le
  · exact (norm_normalizedPairShell_largePrimeStarModes hd).le
  · exact hfreq
  · exact hdelta

end

